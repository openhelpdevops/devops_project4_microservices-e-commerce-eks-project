pipeline {

    agent any

    tools {
        maven "Maven3.9.15"
    }

    environment {

        // Nexus Docker Registry
        REGISTRY_URL = 'nexus.openhelp.net'
        REPO         = 'docker-private/sreejith'
        IMAGE        = 'adservice'
        TAG          = "${BUILD_NUMBER}"

        NEXUS_CREDS = credentials('nexus-cred')

        // GitLab Credentials
        GITLAB_CREDS = credentials('sreejithgit')

        // GitLab Repository
        GIT_REPO_NAME = "microservices-e-commerce-eks-project"
        GIT_USER_NAME = "sreejith"
        GIT_EMAIL     = "sreejithedl@gmail.com"

        // Kubernetes YAML
        YAML_FILE = "adservice.yaml"

        // Docker Image
        IMAGE_PATH = "${REGISTRY_URL}/${REPO}/${IMAGE}:${TAG}"

        // GitOps Branch
        GITOPS_BRANCH = "gitops-adservice-${BUILD_NUMBER}"

        // Email
        EMAIL_TO = "sreejithedl@gmail.com"
    }

    stages {

        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }


        stage('Clone Repo') {
            steps {
                git branch: 'main',
                    credentialsId: 'sreejithgit',
                    url: 'https://gitlab.openhelp.net/sreejith/microservices-e-commerce-eks-project.git'
            }
        }


        stage('Docker Build & Push') {
            steps {

                dir('src/adservice') {

                    sh '''
                        set -e

                        echo "Cleaning unused Docker resources"
                        docker system prune -f

                        echo "Building Docker image"
                        docker build \
                            -t "$IMAGE_PATH" \
                            .

                        echo "Logging into Nexus"
                        echo "$NEXUS_CREDS_PSW" | \
                        docker login "$REGISTRY_URL" \
                            -u "$NEXUS_CREDS_USR" \
                            --password-stdin

                        echo "Pushing Docker image"
                        docker push "$IMAGE_PATH"

                        echo "Docker image pushed successfully:"
                        echo "$IMAGE_PATH"
                    '''
                }
            }
        }


        stage('Update Kubernetes YAML & Create MR') {
            steps {

                dir('kubernetes-files') {

                    sh '''
                        set -e

                        echo "Configuring Git identity"
                        git config user.email "${GIT_EMAIL}"
                        git config user.name "${GIT_USER_NAME}"

                        echo "Creating GitOps branch"
                        git checkout -b "${GITOPS_BRANCH}"

                        echo "Updating Kubernetes YAML"
                        sed -i \
                            "s#image:.*#image: ${IMAGE_PATH}#g" \
                            "${YAML_FILE}"

                        echo "Updated YAML:"
                        cat "${YAML_FILE}"

                        echo "Adding changes"
                        git add "${YAML_FILE}"

                        if git diff --cached --quiet; then
                            echo "No changes found"
                        else
                            git commit \
                                -m "Update adservice image to ${TAG}"
                        fi

                        echo "Pushing branch and creating Merge Request"

                        git push \
                            "https://${GITLAB_CREDS_USR}:${GITLAB_CREDS_PSW}@gitlab.openhelp.net/${GIT_USER_NAME}/${GIT_REPO_NAME}.git" \
                            "HEAD:${GITOPS_BRANCH}" \
                            -o merge_request.create \
                            -o merge_request.target=main \
                            -o merge_request.remove_source_branch \
                            -o merge_request.title="Deploy adservice image ${TAG}" \
                            2>&1 | tee git-push-output.txt

                        echo "Getting Merge Request URL"

                        grep -o \
                            'https://gitlab.openhelp.net[^ ]*/-/merge_requests/[0-9]*' \
                            git-push-output.txt \
                            | tail -1 > mr-url.txt

                        echo "Merge Request URL:"
                        cat mr-url.txt
                    '''
                }
            }
        }


        stage('Send Merge Request Email') {
            steps {

                sh '''
                    echo "Preparing Merge Request Email"

                    MR_URL=$(cat kubernetes-files/mr-url.txt)

                    echo "Merge Request URL:"
                    echo "$MR_URL"

                    cat > mr-email.txt <<EOF
Hi Team,

A new GitLab Merge Request has been created for adservice deployment.

Build Number:
${BUILD_NUMBER}

Docker Image:
${IMAGE_PATH}

GitOps Branch:
${GITOPS_BRANCH}

Please review and approve the Merge Request:

${MR_URL}

Jenkins Build:
${BUILD_URL}

Regards,
Jenkins
EOF
                '''

                emailext(
                    subject: "GitLab Merge Request - adservice Build #${BUILD_NUMBER}",
                    body: '${FILE,path="mr-email.txt"}',
                    to: "${EMAIL_TO}"
                )
            }
        }
    }


    post {

        success {

            echo "PIPELINE SUCCESS"

            echo "Docker Image:"
            echo "${IMAGE_PATH}"

            echo "GitOps Branch:"
            echo "${GITOPS_BRANCH}"

            echo "Merge Request created."

            echo "Merge Request email sent."
        }


        failure {

            echo "PIPELINE FAILED"

            echo "Check Jenkins console output."
        }


        always {

            sh '''
                docker logout "$REGISTRY_URL" \
                    >/dev/null 2>&1 || true
            '''
        }
    }
}
