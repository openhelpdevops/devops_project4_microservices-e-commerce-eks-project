pipeline {

    agent any

    tools {
        maven "Maven3.9.15"
    }

    environment {

        // Nexus Docker Registry
        REGISTRY_URL = 'nexus.openhelp.net'
        REPO         = 'docker-private/sreejith'
        IMAGE        = 'recommendationservice'
        TAG          = "${BUILD_NUMBER}"

        NEXUS_CREDS = credentials('nexus-cred')

        // GitLab Credentials
        GITLAB_CREDS = credentials('sreejithgit')

        // GitLab Repository Information
        GIT_REPO_NAME = "microservices-e-commerce-eks-project"
        GIT_USER_NAME = "sreejith"
        GIT_EMAIL     = "sreejithedl@gmail.com"

        // Kubernetes Deployment YAML
        YAML_FILE = "recommendationservice.yaml"

        // Complete Nexus image path
        IMAGE_PATH = "${REGISTRY_URL}/${REPO}/${IMAGE}:${TAG}"

        // Unique GitOps branch for each Jenkins build
        GITOPS_BRANCH = "gitops-recommendationservice-${BUILD_NUMBER}"
    }

    stages {

        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Clone Repo') {
            steps {
                git branch: 'main',
                    credentialsId: 'sreejithgit',
                    url: 'https://gitlab.openhelp.net/sreejith/microservices-e-commerce-eks-project.git'
            }
        }

        stage('Docker Build & Push') {

            steps {

                script {

                    // Directory containing the recommendationservice Dockerfile
                    dir('src/recommendationservice') {

                        sh '''
                            set -e

                            echo "Cleaning unused Docker resources"
                            docker system prune -f
                            docker container prune -f

                            echo "Building Docker image"
                            docker build \
                                -t "$REGISTRY_URL/$REPO/$IMAGE:$TAG" \
                                .

                            echo "Logging into Nexus Docker Registry"
                            echo "$NEXUS_CREDS_PSW" | docker login "$REGISTRY_URL" \
                                -u "$NEXUS_CREDS_USR" \
                                --password-stdin

                            echo "Pushing Docker image to Nexus"
                            docker push "$REGISTRY_URL/$REPO/$IMAGE:$TAG"

                            echo "Docker image pushed successfully:"
                            echo "$IMAGE_PATH"
                        '''
                    }
                }
            }
        }

        stage('Update Kubernetes Deployment File') {

            steps {

                dir('kubernetes-files') {

                    sh '''
                        set -e

                        echo "Configuring Git identity"
                        git config user.email "${GIT_EMAIL}"
                        git config user.name "${GIT_USER_NAME}"

                        echo "Creating GitOps branch: ${GITOPS_BRANCH}"
                        git checkout -b "${GITOPS_BRANCH}"

                        echo "Updating Kubernetes YAML file: ${YAML_FILE}"

                        sed -i \
                            "s#image:.*#image: ${IMAGE_PATH}#g" \
                            "${YAML_FILE}"

                        echo "Updated Kubernetes deployment file:"
                        cat "${YAML_FILE}"

                        git add "${YAML_FILE}"

                        if git diff --cached --quiet; then
                            echo "No Kubernetes YAML changes to commit"
                        else
                            git commit \
                                -m "Update recommendationservice image to ${TAG}"
                        fi

                        echo "Pushing GitOps branch and creating Merge Request"

                        git push \
                            "https://${GITLAB_CREDS_USR}:${GITLAB_CREDS_PSW}@gitlab.openhelp.net/${GIT_USER_NAME}/${GIT_REPO_NAME}.git" \
                            "HEAD:${GITOPS_BRANCH}" \
                            -o merge_request.create \
                            -o merge_request.target=main \
                            -o merge_request.remove_source_branch \
                            -o merge_request.title="Deploy recommendationservice image ${TAG}"
                    '''
                }
            }
        }
    }

    post {

        success {
            echo "PIPELINE SUCCESS 🚀"
            echo "Recommendationservice Docker image pushed to Nexus: ${IMAGE_PATH}"
            echo "GitLab Merge Request created."
            echo "Review, approve and merge the GitOps branch into main."
        }

        failure {
            echo "PIPELINE FAILED ❌"
            echo "Check the Jenkins console output for the failed stage."
        }

        always {
            sh '''
                docker logout "$REGISTRY_URL" >/dev/null 2>&1 || true
            '''
        }
    }
}
